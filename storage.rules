rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Listing images can be read publicly, but only the signed-in owner can upload/delete them.
    match /listing-images/{uid}/{fileName} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Vault documents are private to their owner in this starter policy. Do not unlock public
    // or paid downloads until access rules and entitlement checks are designed and tested.
    match /vault-files/{uid}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
